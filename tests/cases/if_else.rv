// if / else if / else chains take exactly one branch.
// Expected output: 2, 3, 1
func classify(n: int) -> int {
    if n < 0 {
        return 1;
    } else if n == 0 {
        return 2;
    } else {
        return 3;
    }
}

func main() {
    print classify(0);
    print classify(5);
    print classify(0 - 5);
}
