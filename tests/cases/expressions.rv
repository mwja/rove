// `if`, `switch` and blocks are expressions, whose value is that of the branch
// taken. A branch that diverges has no value, so takes the other branches' type.
// Expected output: -1, 0, 1, 30, 7, 2, 10, 4, 5
enum Colour {
    Red,
    Green,
    Blue
}

func sign(x: int) -> int {
    if x < 0 {
        -1
    } else if x == 0 {
        0
    } else {
        1
    }
}

func code(c: Colour) -> int {
    switch c {
        case ::Red => { 1 }
        case ::Green => { 2 }
        case ::Blue => { 3 }
    }
}

func first_even(from: int) -> int {
    var n = from;
    loop {
        if n / 2 * 2 == n {
            return n;
        }
        n = n + 1;
    }
}

// `return` is an expression too, so can be a tail.
func five() -> int {
    return 5
}

func main() {
    print sign(-5);
    print sign(0);
    print sign(9);

    let a = if true { 10 } else { 20 } + 20;
    print a;

    let b = {
        let x = 3;
        x + 4
    };
    print b;

    print code(Colour::Green);

    let c = if a > 100 { return; } else { 10 };
    print c;

    // A value can be discarded with a `;`.
    if true { 1 } else { 2 };

    print first_even(3);
    print five();
}
