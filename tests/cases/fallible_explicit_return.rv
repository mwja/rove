// A function that throws may return a plain value with an explicit return,
// just as it can with an implicit one.
// Expected output: 1
enum PurchaseError {
    OutOfStock
}

func buy(stock: int) throws PurchaseError -> int
    guard stock > 0 else ::OutOfStock
{
    return stock;
}

func main() {
    print try! buy(1);
}
