// if/switch/block expressions that produce structs, including tails that are
// locals of the scope being left.
// Expected output: 1, 2, 3, 20, 30, 7
struct Point {
    var x: int,
    var y: int
}

func pick(n: int) -> Point {
    switch n {
        case 1 => {
            let p = Point.{ x = 10, y = 10 };
            p
        }
        case 2 => { Point.{ x = 20, y = 20 } }
        else => { Point.{ x = 30, y = 30 } }
    }
}

func main() {
    let a = {
        let inner = Point.{ x = 1, y = 1 };
        inner
    };
    print a.x;

    let b = if a.x == 1 {
        Point.{ x = 2, y = 2 }
    } else {
        a
    };
    print b.x;

    let c = if a.x == 0 {
        Point.{ x = 0, y = 0 }
    } else {
        let d = Point.{ x = 3, y = 3 };
        d
    };
    print c.x;

    print pick(2).x;
    let e = pick(3);
    print e.x;

    // block value discarded
    {
        let f = Point.{ x = 7, y = 7 };
        f
    };
    print 7;
}
