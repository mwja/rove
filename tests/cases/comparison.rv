// Comparison operators bind looser than arithmetic.
// Expected output: 1, 2, 3, 4, 5, 6
func main() {
    if 1 + 1 == 2 { print 1; }
    if 2 * 3 > 5 { print 2; }
    if 3 != 4 { print 3; }
    if 4 <= 4 { print 4; }
    if 5 >= 4 { print 5; }
    if 1 < 2 { print 6; }
    if 2 < 1 { print 999; }
}
