// Expected output: 1, 2, 3, 5000, 18, 0, 7
enum Unit {
    tens,
    hundreds,
    thousands
}

func unit(n: int) throws Unit -> int
    guard n >= 10 else ::tens
{
    guard n >= 100 else ::hundreds;
    guard n >= 1000 else {
        throw ::thousands;
    }
    return n;
}

func scale(n: int) -> int {
    return try unit(n) catch |err| {
        switch err {
            case ::tens => { return 1; }
            case ::hundreds => { return 2; }
            case ::thousands => { return 3; }
        }
    };
}

func clamp_positive(n: int) -> int {
    guard n > 0 else {
        return 0;
    }
    n
}

func main() {
    print scale(5);
    print scale(50);
    print scale(500);
    print scale(5000);

    let total = 0;
    let i = 0;
    while i < 6 {
        i = i + 1;
        guard i != 3 else {
            continue;
        }
        total = total + i;
    }
    print total;

    print clamp_positive(0 - 4);
    print clamp_positive(7);
}
