func main() {
    greet();
}
func greet() { print 42; output(43); }

func output(digit: int) {
    print digit;
}



func double(value: int) -> int {
    if value <= 0 {
        return 0;
    }
    return value * 2;
}


func safe_early_return() {
    if 1 == 1 {
        return;
    }

    // no return here needed as return type is void
}
