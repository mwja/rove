enum VDirection {
    Positive,
    Negative
}

func move(v: int, direction: VDirection) -> int {
    if direction == VDirection::Positive {
        return v + 1;
    } else {
        return v - 1;
    }
}

enum Boolean {
    false,
    true,
    maybe
}

func xor(left: Boolean, right: Boolean) -> Boolean {
    if left == right {
        return ::false;
    }
    return ::true;
}

func main() {
    let v = 0;
    v = move(v, ::Positive);
    v = move(v, ::Negative);
    v = move(v, ::Negative);

    let should_be_0 = xor(::true, ::true);
    let should_be_1 = xor(::true, ::false);
    let should_be_1_again = xor(::false, ::true);
    let should_be_0_again = xor(::false, ::false);

    switch should_be_1 {
        case ::false => {
          print 0-100;
        }

        case ::true => {
          print 100;
          fallthrough;
        }

        else => {
          print 6000;
        }
    }

    switch v {
        case 0 => {
          print 0-101;
        }

        case 1 => {
          print 0-102;
          fallthrough;
        }

        case 0-1 => {
          print 0-104;
        }

        else => {
          print 0-103;
        }
    }

    print should_be_0;
    print should_be_1;
    print should_be_1_again;
    print should_be_0_again;

    // should be -1
    print v;
}
